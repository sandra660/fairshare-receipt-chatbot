# Copy this file to .env and fill it in. Never commit .env to GitHub.

# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-gemini-api-key-here

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers), with your password filled in
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fairshare

# Optional: change if Google renames or retires the model (https://ai.google.dev/gemini-api/docs/models)
GEMINI_CHAT_MODEL=gemini-3.5-flash
